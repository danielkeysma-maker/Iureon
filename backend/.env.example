
# ─── Wompi (recargas) ─────────────────────────────────────────────────────────
# Las cuatro o ninguna: una pasarela a medias cobra sin acreditar, o acredita
# sin cobrar. Se consiguen en el Dashboard de Wompi -> Desarrolladores, y hay
# un juego para pruebas (pub_test_ / prv_test_) y otro para producción.
#
# SOLO LA PÚBLICA VIAJA AL NAVEGADOR. Las otras tres son secretos: quien tenga
# el de eventos puede acreditarse saldo, y quien tenga el de integridad puede
# firmar cualquier monto.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# A dónde vuelve el cliente después de pagar.
WOMPI_REDIRECT_URL=
