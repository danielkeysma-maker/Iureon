
# ─── Wompi (recargas) ─────────────────────────────────────────────────────────
# Las cuatro o ninguna: una pasarela a medias cobra sin acreditar, o acredita
# sin cobrar. Se consiguen en el Dashboard de Wompi -> Desarrolladores, y hay
# un juego para pruebas (pub_test_ / prv_test_) y otro para producción.
#
# SOLO LA PÚBLICA VIAJA AL NAVEGADOR. Las otras tres son secretos: quien tenga
# el de eventos puede acreditarse saldo, y quien tenga el de integridad puede
# firmar cualquier monto.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# A dónde vuelve el cliente después de pagar.
WOMPI_REDIRECT_URL=

# ─── Buscador web (descubrimiento por tema) ───────────────────────────────────
# Apunta hacia sentencias en el sitio de la Corte; NUNCA decide qué dicen ni que
# existan. Cada número que devuelve lo confirma el registro oficial del Estado
# antes de descargar nada. Sin esta llave, el descubrimiento por tema queda
# apagado y el resto del buscador funciona igual.
# Se obtiene en https://brave.com/search/api/ (tiene plan gratuito).
BRAVE_SEARCH_API_KEY=
