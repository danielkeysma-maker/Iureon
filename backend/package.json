{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API SaaS Multi-tenant para Iureon (Automatización Jurídica RAG en Colombia)",
  "main": "dist/index.js",
  "scripts": {
    "test": "node scripts/run-all-checks.mjs",
    "test:todos": "node scripts/run-all-checks.mjs --todos",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check:catalog": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/catalog/__checks__/catalog.check.ts",
    "check:embeddings": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/embeddings/__checks__/embeddings.check.ts",
    "smoke:embeddings": "npx ts-node --transpile-only src/scripts/smokeLocalEmbeddings.ts",
    "check:search": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/search/__checks__/search.check.ts",
    "superadmin": "npx ts-node -P tsconfig.check.json --transpile-only src/scripts/createSuperAdmin.ts",
    "adopt": "npx ts-node -P tsconfig.check.json --transpile-only src/scripts/adoptOrphanData.ts",
    "check:admin": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/admin/__checks__/admin.check.ts",
    "check:billing": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/billing/__checks__/billing.check.ts",
    "check:clients": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/clients/__checks__/clients.check.ts",
    "check:auth": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/auth/__checks__/auth.check.ts",
    "check:roles": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/transcription/__checks__/roleProposer.check.ts",
    "check:stored": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/transcription/__checks__/storedList.check.ts",
    "check:names": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/transcription/__checks__/speakerNames.check.ts",
    "check:conflicts": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/transcription/__checks__/voiceConflicts.check.ts",
    "check:retrieval": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/search/__checks__/retrieval.check.ts",
    "ingest:corpus": "npx ts-node --transpile-only src/scripts/ingestCorpus.ts",
    "check:wompi": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/billing/wompi/__checks__/wompi.check.ts",
    "check:conceptos": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/ingestion/__checks__/conceptos.check.ts",
    "ingest:conceptos": "npx ts-node --transpile-only src/scripts/ingestConceptos.ts",
    "check:subprocessors": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/privacy/__checks__/subprocessors.check.ts",
    "check:ruling": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/jurisprudence/__checks__/officialRuling.check.ts",
    "check:discovery": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/jurisprudence/__checks__/discovery.check.ts",
    "check:triage": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/catalog/__checks__/triage.check.ts",
    "check:precedent": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/agent/__checks__/precedent.check.ts",
    "check:csj": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/jurisprudence/__checks__/csjRuling.check.ts",
    "check:runway": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/admin/__checks__/runway.check.ts",
    "check:cupo": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/catalog/__checks__/orientacionQuota.check.ts",
    "check:prefs": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/preferences/__checks__/preferences.check.ts",
    "check:drafts": "npx ts-node -P tsconfig.check.json --transpile-only src/modules/drafts/__checks__/drafts.check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "backblaze-b2": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "openai": "^4.86.1",
    "pdf-parse": "^2.4.5",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.5",
    "@types/word-extractor": "^1.0.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
