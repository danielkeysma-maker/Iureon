{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint",
    "brand": "node scripts/build-brand.mjs && node scripts/build-brand-illustration.mjs",
    "brand:letras": "python scripts/wordmark-to-paths.py",
    "check:tokens": "npx tsx src/design/__checks__/tokens.check.ts",
    "preview": "vite preview",
    "check:informe": "npx esbuild src/modules/workspace/__checks__/informe.check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/informe.check.cjs --log-level=error && node node_modules/.cache/informe.check.cjs",
    "check:formato": "npx esbuild src/modules/documents/__checks__/formato.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/formato.check.mjs --log-level=error && node node_modules/.cache/formato.check.mjs",
    "check:guion": "npx esbuild src/modules/clients/__checks__/guion.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/guion.check.mjs --log-level=error && node node_modules/.cache/guion.check.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@emnapi/runtime": "1.11.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.23",
    "postcss-import": "^17.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-node": "^6.0.0"
  }
}
